# GitHub API Token (read-only public access recommended)
GITHUB_TOKEN=

# Database Connection (defaults to local SQLite)
DATABASE_URL=sqlite:///./data/app.db

# Storage Directories
DATA_DIR=./data
MODELS_DIR=./models

# Analysis & Cache Settings
CACHE_TTL_SECONDS=3600
MAX_REPO_SIZE_MB=300
MAX_FILES=3000
MAX_FILE_KB=500
HISTORY_MONTHS=12
MAX_CONCURRENT_ANALYSES=2

# Feature Flags
ENABLE_SEMGREP=false
ENABLE_CODEBERT=false
ENABLE_ASSISTANT_INDEX=true

# AI Assistant & RAG
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Training
TRAIN_MAX_REPO_MB=150

# Logging
LOG_LEVEL=INFO
